# Upgrade every plain HTTP request to HTTPS on the domain.
http:// {
	redir https://pirots.walkablecity.app{uri} permanent
}

# Caddy automatically obtains and renews a certificate (though Let's Encrypt) 
# for this domain and stores it in /data (in the caddy_data volume).
pirots.walkablecity.app {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; worker-src 'self' blob:; connect-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:4173
	}
}
