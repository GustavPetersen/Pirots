# Upgrade every plain HTTP request to HTTPS on the domain.
http:// {
	redir https://pirots.walkablecity.app{uri} permanent
}

# Caddy automatically obtains and renews a certificate (though Let's Encrypt) 
# for this domain and stores it in /data (in the caddy_data volume).
pirots.walkablecity.app {
	encode gzip zstd

	@api path /api /api/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:4173
	}
}
