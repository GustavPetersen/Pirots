# Copy to .env for local development. In Dokploy, set these in the Environment tab instead.

# Postgres connection string
# Local:   postgres://postgres:dev@localhost:5432/pirots
# Dokploy: use the Internal Connection URL from the Postgres service
DATABASE_URL=postgres://postgres:dev@localhost:5432/pirots

# Secret for signing session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me