# Static file server for the built frontend (production stage of frontend/Dockerfile).
# TLS and security headers are handled by the outer proxy (proxy/Caddyfile).
{
	admin off
	auto_https off
}

:4173 {
	root * /srv
	encode gzip zstd

	# Vite emits content-hashed filenames under /assets, safe to cache forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# SPA fallback for BrowserRouter deep links.
	try_files {path} /index.html
	file_server
}
