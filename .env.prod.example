# Copy to .env for local development. In Dokploy, set these in the Environment tab instead.

POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_pw
POSTGRES_DB_NAME=dev_db

# Postgres connection string (Npgsql format). In Dokploy, take host/user/password/db
# from the Postgres service's internal connection details.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=pirots;Username=postgres;Password=change-me
